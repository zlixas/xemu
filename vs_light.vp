!!VP1.1
# Light vertex program: transform to screen space and pass attributes through.
#   c[0..3]  object -> screen matrix (rows)
#   v[OPOS] position, v[COL0] diffuse color, v[TEX0] texcoord0 (NV2A inputs 0, 3, 9)
DP4 R0.x, v[OPOS], c[0];
DP4 R0.y, v[OPOS], c[1];
DP4 R0.z, v[OPOS], c[2];
DP4 R0.w, v[OPOS], c[3];
RCP R1.x, R0.w;
MUL o[HPOS].xyz, R0, R1.x;
MOV o[HPOS].w, R0.w;
MOV o[COL0], v[COL0];
MOV o[COL1], v[COL0];
MOV o[FOGC].x, R0.w;
MOV o[TEX0], v[TEX0];
MOV o[TEX1], v[TEX0];
MOV o[TEX2], v[TEX0];
MOV o[TEX3], v[TEX0];
END
